# Chave do Google AI Studio (https://aistudio.google.com/apikey) — obrigatória
GEMINI_API_KEY=

# ID da skill (amzn1.ask.skill.xxxx) — recomendado: rejeita requisições de outras skills
ALEXA_SKILL_ID=

# Opcionais
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=6000

# Somente para testes locais (curl / vercel dev). NUNCA use "true" em produção.
SKIP_ALEXA_VERIFICATION=false
